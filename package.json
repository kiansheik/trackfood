{
  "name": "trackfood",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc -b",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "native:android": "npm run build && cap sync android && cap open android",
    "native:ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@pantrist/capacitor-plugin-ml-kit-text-recognition": "^8.0.0",
    "@zxing/browser": "^0.1.5",
    "dexie": "^4.0.11",
    "pinia": "^2.3.1",
    "tesseract.js": "^6.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@types/node": "^22.10.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.7.0",
    "@eslint/js": "^9.18.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  }
}
